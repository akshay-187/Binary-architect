# ==============================================================================
# PatchPilot-Python Environment Variables Template
# Copy this file to .env and configure your actual credentials.
# ==============================================================================

# IBM Bob / Watsonx Configuration
IBM_BOB_API_KEY=your_ibm_bob_api_key_here
IBM_BOB_PROJECT_ID=your_ibm_bob_project_id_here
IBM_BOB_ENDPOINT=https://us-south.ml.cloud.ibm.com
IBM_BOB_MODEL_ID=ibm/granite-3-8b-instruct

# App & Server Settings
APP_HOST=127.0.0.1
APP_PORT=8501
LOG_LEVEL=INFO

# Target Workspace
DEFAULT_REPO_PATH=./sample_repository
SESSIONS_DIR=./bob_sessions
REPORTS_DIR=./bob_sessions/reports
BENCHMARK_RESULTS_PATH=./benchmark/evaluation-results.json
